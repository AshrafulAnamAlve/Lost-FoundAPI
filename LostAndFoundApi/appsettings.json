{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Development only. This file is committed to a public repository, so the live
  // database's credentials must never appear here - they live in
  // appsettings.Production.json, which is gitignored and carried to the host by
  // `dotnet publish`, exactly like the HuggingFace key below.
  //
  // To run a migration against the live database, ask for that environment
  // explicitly - otherwise EF reads this string and updates LocalDB instead:
  //   $env:ASPNETCORE_ENVIRONMENT="Production"; dotnet ef database update
  "ConnectionStrings": {
    "LAFConntection": "Server=(localdb)\\MSSQLLocalDB; Database=LostAndFoundDb; Trusted_Connection=True; TrustServerCertificate=True"
  },
  // Self-hosted embedding service (see /ml_service). Preferred provider: no API key,
  // no rate limit, works offline. Leave empty to disable and fall back to HuggingFace.
  "Embedding": {
    "ServiceUrl": "http://localhost:8000"
  },

  // Item image classifier. Classification is optional everywhere - if it is
  // unavailable, items post exactly as they did before, just without a detected
  // category.
  //
  // Provider:
  //   "auto"     (default) in-process when MLModels/model.onnx is present,
  //              otherwise the ml_service URL below
  //   "onnx"     always in-process - no Python needed, and the model file ships
  //              with `dotnet publish`, which is what makes this work on the host
  //   "service"  always POST to ml_service, for when the model is hosted
  //              somewhere with more memory than shared hosting has
  //
  // ServiceUrl is only read by the "service" provider. It falls back to
  // Embedding:ServiceUrl when left empty, since that is normally the same process.
  "ImageClassification": {
    "Provider": "auto",
    "ServiceUrl": "http://localhost:8000",
    "TimeoutSeconds": 10
  },

  // Fallback provider, used when Embedding:ServiceUrl is unreachable or unset - which
  // is exactly the hosted case, where the API runs on a server that has no ml_service
  // beside it. Same model as the local service, so scores stay directly comparable.
  //
  // Never put the key here: this file is committed to a public repository. Supply it
  // out of band instead:
  //   local dev  ->  dotnet user-secrets set "HuggingFace:ApiKey" "hf_..."
  //   hosting    ->  environment variable  HuggingFace__ApiKey
  "HuggingFace": {
    "ApiKey": "",
    "Model": "sentence-transformers/all-MiniLM-L6-v2"
  },
  "AllowedHosts": "*"
}
