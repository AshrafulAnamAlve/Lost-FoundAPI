{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "LAFConntection": "Server=(localdb)\\MSSQLLocalDB; Database=LostAndFoundDb; Trusted_Connection=True; TrustServerCertificate=True"
  },
  // Self-hosted embedding service (see /ml_service). Preferred provider: no API key,
  // no rate limit, works offline. Leave empty to disable and fall back to HuggingFace.
  "Embedding": {
    "ServiceUrl": "http://localhost:8000"
  },

  // Fallback provider, used when Embedding:ServiceUrl is unreachable or unset - which
  // is exactly the hosted case, where the API runs on a server that has no ml_service
  // beside it. Same model as the local service, so scores stay directly comparable.
  //
  // Never put the key here: this file is committed to a public repository. Supply it
  // out of band instead:
  //   local dev  ->  dotnet user-secrets set "HuggingFace:ApiKey" "hf_..."
  //   hosting    ->  environment variable  HuggingFace__ApiKey
  "HuggingFace": {
    "ApiKey": "",
    "Model": "sentence-transformers/all-MiniLM-L6-v2"
  },
  "AllowedHosts": "*"
}
