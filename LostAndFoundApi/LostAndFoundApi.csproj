<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a11536b5-d623-43fe-93f9-6e8ad65da58e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Pinned to 1.22.0 on purpose: it is the LAST version that ships a win-x86 build.
      1.23.0 dropped runtimes/win-x86 entirely, and the site runs in a 32-bit IIS app
      pool, so anything newer cannot load at all there - the classifier reports a
      TypeInitializationException and every item posts without a category.

      Before upgrading, check /api/health: if `classifier.runtime` still says
      "X86 process", the pool is still 32-bit and this pin has to stay.
    -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
  </ItemGroup>

  <!--
    The image classifier's weights, read at runtime by OnnxItemClassificationService.
    They have to be listed here or they stay on the development machine: the host runs
    whatever `dotnet publish` produced, and content is only published when something
    copies it to the output.

    These are a copy of ml_service/models/. Both are needed - the Python service loads
    that copy, this process loads this one - so re-export replaces both, together.
  -->
  <ItemGroup>
    <!-- Include for .onnx, Update for .json: the Web SDK already treats every .json
         under the project as content, and listing one twice is a build error. -->
    <Content Include="MLModels\**\*.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="MLModels\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <!-- The Web SDK publishes any loose file under the project as content, which would
         put these in a NativeSupport\ folder where nothing looks for them. The target
         below places them where they are actually needed instead. -->
    <Content Remove="NativeSupport\**" />
    <None Include="NativeSupport\**" />
  </ItemGroup>

  <!--
    onnxruntime.dll imports the Visual C++ runtime - MSVCP140, MSVCP140_1 and
    VCRUNTIME140, plus VCRUNTIME140_1 in the 64-bit build only. A developer machine
    has it because Visual Studio installs it; a shared host often does not, and there
    is no way to run an installer there. Without it the DLL will not load and the
    classifier reports a TypeInitializationException with no hint as to why.

    They go beside onnxruntime.dll rather than in the app root on purpose: .NET loads
    it by full path with LOAD_WITH_ALTERED_SEARCH_PATH, so Windows resolves its
    imports from that DLL's own folder first. Under IIS in-process hosting the app
    root is not the process directory, so putting them there would not reliably work.

    Both architectures ship because the app pool's bitness is the host's choice, not
    ours, and it is not visible from here - win-x86 came from SysWOW64, win-x64 from
    System32. The folders are named win-x64/win-x86 rather than x64/x86 because the
    Visual Studio .gitignore ignores x64/ and x86/ as build output - under those
    names the files never reach the repository, and a publish from a second machine
    silently loses them.

    Publish only - a local build does not need them, and copying them into bin would
    shadow the machine's own copies for no reason.
  -->
  <Target Name="PublishVisualCppRuntimeBesideOnnx" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <!-- Anything already queued from NativeSupport\ would land in a folder nothing
           looks in, and two entries for one file is a hard error - so drop those
           first, then add them back under the paths they need. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('NativeSupport'))" />

      <!-- Qualified metadata (%(VcRuntimeX64.Filename)), not bare %(Filename): the
           unqualified form batches over the wrong item list here and resolves empty. -->
      <VcRuntimeX64 Include="NativeSupport\win-x64\*.dll" />
      <VcRuntimeX86 Include="NativeSupport\win-x86\*.dll" />

      <ResolvedFileToPublish Include="@(VcRuntimeX64)">
        <RelativePath>runtimes\win-x64\native\%(VcRuntimeX64.Filename)%(VcRuntimeX64.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>

      <ResolvedFileToPublish Include="@(VcRuntimeX86)">
        <RelativePath>runtimes\win-x86\native\%(VcRuntimeX86.Filename)%(VcRuntimeX86.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    ONNX Runtime ships a native build for every platform it supports - Android, iOS,
    macOS and Linux included - and a portable publish copies all of them. That is
    235 MB of the 274 MB output, none of it reachable: this deploys to Windows IIS
    over Web Deploy, on a metered upload to a free host.

    Only the foreign platforms are dropped. Every runtimes\win* folder stays - which
    matters, because win-x86 is the one this host actually loads - and so does
    runtimes\unix, which SqlClient uses. Nothing here is specific to ONNX Runtime;
    any package with the same layout is trimmed the same way.
  -->
  <Target Name="RemoveForeignNativeRuntimes" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^runtimes[\\/](android|ios|linux|osx|maccatalyst|browser)'))" />
    </ItemGroup>
  </Target>

</Project>
